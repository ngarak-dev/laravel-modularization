<?php

declare(strict_types=1);

namespace {{namespace}}\{{moduleName}}\Livewire;

use Illuminate\Contracts\View\View;
use Livewire\Component;
use Livewire\WithPagination;
use {{namespace}}\{{moduleName}}\Services\Interfaces\{{className}}ServiceInterface;

class {{className}}Table extends Component
{
    use WithPagination;

    public string $search = '';

    public int $perPage = 10;

    public string $sortField = 'created_at';

    public string $sortDirection = 'desc';

    public function updatingSearch(): void
    {
        $this->resetPage();
    }

    public function sortBy(string $field): void
    {
        if ($this->sortField === $field) {
            $this->sortDirection = $this->sortDirection === 'asc' ? 'desc' : 'asc';
        } else {
            $this->sortDirection = 'asc';
        }

        $this->sortField = $field;
    }

    public function delete(int|string $id): void
    {
        app({{className}}ServiceInterface::class)->delete($id);

        $this->dispatch('{{classNameLower}}Deleted');
        session()->flash('message', '{{className}} deleted successfully');
    }

    public function render(): View
    {
        return view('{{moduleNameLower}}::livewire.{{classNameLower}}-table', [
            '{{classNameLower}}s' => app({{className}}ServiceInterface::class)->getAll(),
        ]);
    }
}
