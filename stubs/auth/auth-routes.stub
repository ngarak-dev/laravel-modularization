<?php

use Illuminate\Support\Facades\Route;
use {{namespace}}\{{moduleName}}\Http\Controllers\Auth\LoginController;
use {{namespace}}\{{moduleName}}\Http\Controllers\Auth\RegisterController;
use {{namespace}}\{{moduleName}}\Http\Controllers\Auth\ForgotPasswordController;
use {{namespace}}\{{moduleName}}\Http\Controllers\Auth\ResetPasswordController;
use {{namespace}}\{{moduleName}}\Http\Controllers\Auth\VerifyEmailController;

/*
|--------------------------------------------------------------------------
| Authentication Routes
|--------------------------------------------------------------------------
|
| Here is where you can register authentication routes for your module.
|
*/

Route::middleware('web')->group(function () {
    // Guest routes
    Route::middleware('{{moduleNameLower}}.guest')->group(function () {
        // Login routes
        Route::get('/login', [LoginController::class, 'showLoginForm'])
            ->name('{{moduleNameLower}}.login');
        Route::post('/login', [LoginController::class, 'login']);
        
        // Registration routes
        Route::get('/register', [RegisterController::class, 'showRegistrationForm'])
            ->name('{{moduleNameLower}}.register');
        Route::post('/register', [RegisterController::class, 'register']);
        
        // Password reset routes
        Route::get('/forgot-password', [ForgotPasswordController::class, 'showLinkRequestForm'])
            ->name('{{moduleNameLower}}.password.request');
        Route::post('/forgot-password', [ForgotPasswordController::class, 'sendResetLinkEmail'])
            ->name('{{moduleNameLower}}.password.email');
        Route::get('/reset-password/{token}', [ResetPasswordController::class, 'showResetForm'])
            ->name('{{moduleNameLower}}.password.reset');
        Route::post('/reset-password', [ResetPasswordController::class, 'reset'])
            ->name('{{moduleNameLower}}.password.update');
    });

    // Auth routes
    Route::middleware('{{moduleNameLower}}.auth')->group(function () {
        Route::post('/logout', [LoginController::class, 'logout'])
            ->name('{{moduleNameLower}}.logout');
        
        // Email verification routes
        Route::get('/email/verify', [VerifyEmailController::class, 'show'])
            ->name('{{moduleNameLower}}.verification.notice');
        Route::get('/email/verify/{id}/{hash}', [VerifyEmailController::class, 'verify'])
            ->name('{{moduleNameLower}}.verification.verify');
        Route::post('/email/verification-notification', [VerifyEmailController::class, 'send'])
            ->name('{{moduleNameLower}}.verification.send');
    });
}); 