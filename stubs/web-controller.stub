<?php

declare(strict_types=1);

namespace {{namespace}}\{{moduleName}}\Http\Controllers;

use App\Http\Controllers\Controller;
use Illuminate\Http\RedirectResponse;
use Illuminate\View\View;
use {{namespace}}\{{moduleName}}\Http\Requests\{{className}}Request;
use {{namespace}}\{{moduleName}}\Services\Interfaces\{{className}}ServiceInterface;

class {{className}}Controller extends Controller
{
    public function __construct(
        protected {{className}}ServiceInterface $service,
    ) {
    }

    public function index(): View
    {
        ${{classNameLower}}s = $this->service->getAll();

        return view('{{moduleNameLower}}::{{classNameLower}}.index', compact('{{classNameLower}}s'));
    }

    public function create(): View
    {
        return view('{{moduleNameLower}}::{{classNameLower}}.create');
    }

    public function store({{className}}Request $request): RedirectResponse
    {
        $this->service->create($request->validated());

        return redirect()->route('{{classNameLower}}.index')->with('success', '{{className}} created successfully');
    }

    public function show(string $id): View
    {
        ${{classNameLower}} = $this->service->findById($id);

        return view('{{moduleNameLower}}::{{classNameLower}}.show', compact('{{classNameLower}}'));
    }

    public function edit(string $id): View
    {
        ${{classNameLower}} = $this->service->findById($id);

        return view('{{moduleNameLower}}::{{classNameLower}}.edit', compact('{{classNameLower}}'));
    }

    public function update({{className}}Request $request, string $id): RedirectResponse
    {
        $this->service->update($id, $request->validated());

        return redirect()->route('{{classNameLower}}.index')->with('success', '{{className}} updated successfully');
    }

    public function destroy(string $id): RedirectResponse
    {
        $this->service->delete($id);

        return redirect()->route('{{classNameLower}}.index')->with('success', '{{className}} deleted successfully');
    }
}
