<?php

declare(strict_types=1);

namespace {{namespace}}\{{moduleName}}\Http\Controllers;

use Illuminate\Http\RedirectResponse;
use Illuminate\Http\Request;
use Illuminate\Routing\Controller;
use Illuminate\View\View;
use {{namespace}}\{{moduleName}}\Services\Interfaces\{{moduleName}}ServiceInterface;

class {{moduleName}}Controller extends Controller
{
    public function __construct(
        protected {{moduleName}}ServiceInterface $service,
    ) {
    }

    public function index(): View
    {
        $items = $this->service->all();

        return view('{{moduleNameLower}}::{{moduleNameLower}}.index', compact('items'));
    }

    public function create(): View
    {
        return view('{{moduleNameLower}}::{{moduleNameLower}}.create');
    }

    public function store(Request $request): RedirectResponse
    {
        $this->service->create($request->validated());

        return redirect()->route('{{moduleNameLower}}.index')
            ->with('success', '{{moduleName}} created successfully.');
    }

    public function show(int $id): View
    {
        $item = $this->service->find($id);

        return view('{{moduleNameLower}}::{{moduleNameLower}}.show', compact('item'));
    }

    public function edit(int $id): View
    {
        $item = $this->service->find($id);

        return view('{{moduleNameLower}}::{{moduleNameLower}}.edit', compact('item'));
    }

    public function update(Request $request, int $id): RedirectResponse
    {
        $this->service->update($id, $request->validated());

        return redirect()->route('{{moduleNameLower}}.index')
            ->with('success', '{{moduleName}} updated successfully.');
    }

    public function destroy(int $id): RedirectResponse
    {
        $this->service->delete($id);

        return redirect()->route('{{moduleNameLower}}.index')
            ->with('success', '{{moduleName}} deleted successfully.');
    }
}
