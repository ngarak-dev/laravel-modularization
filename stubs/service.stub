<?php

declare(strict_types=1);

namespace {{namespace}}\{{moduleName}}\Services;

use Illuminate\Database\Eloquent\Collection;
use {{namespace}}\{{moduleName}}\Models\{{className}};
use {{namespace}}\{{moduleName}}\Repositories\Interfaces\{{className}}RepositoryInterface;
use {{namespace}}\{{moduleName}}\Services\Interfaces\{{className}}ServiceInterface;

class {{className}}Service implements {{className}}ServiceInterface
{
    public function __construct(
        protected {{className}}RepositoryInterface $repository,
    ) {
    }

    /**
     * @return Collection<int, {{className}}>
     */
    public function getAll(): Collection
    {
        return $this->repository->all();
    }

    public function findById(int|string $id): {{className}}
    {
        return $this->repository->findById($id);
    }

    public function create(array $data): {{className}}
    {
        return $this->repository->create($data);
    }

    public function update(int|string $id, array $data): {{className}}
    {
        return $this->repository->update($id, $data);
    }

    public function delete(int|string $id): bool
    {
        return $this->repository->delete($id);
    }
}
