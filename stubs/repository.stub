<?php

declare(strict_types=1);

namespace {{namespace}}\{{moduleName}}\Repositories;

use Illuminate\Database\Eloquent\Collection;
use Illuminate\Pagination\LengthAwarePaginator;
use {{namespace}}\{{moduleName}}\Models\{{className}};
use {{namespace}}\{{moduleName}}\Repositories\Interfaces\{{className}}RepositoryInterface;

class {{className}}Repository implements {{className}}RepositoryInterface
{
    public function __construct(
        protected {{className}} $model,
    ) {
    }

    /**
     * @return Collection<int, {{className}}>
     */
    public function all(): Collection
    {
        return $this->model->all();
    }

    /**
     * @return Collection<int, {{className}}>
     */
    public function getAll(): Collection
    {
        return $this->all();
    }

    /**
     * @return LengthAwarePaginator<int, {{className}}>
     */
    public function paginate(int $perPage = 15): LengthAwarePaginator
    {
        return $this->model->paginate($perPage);
    }

    public function create(array $data): {{className}}
    {
        return $this->model->create($data);
    }

    public function update(int|string $id, array $data): {{className}}
    {
        $record = $this->findById($id);
        $record->update($data);

        return $record;
    }

    public function delete(int|string $id): bool
    {
        return (bool) $this->findById($id)->delete();
    }

    public function find(int|string $id): ?{{className}}
    {
        return $this->model->find($id);
    }

    public function findById(int|string $id): {{className}}
    {
        return $this->model->findOrFail($id);
    }
}
