<?php

declare(strict_types=1);

namespace {{namespace}}\{{moduleName}}\Livewire;

use Illuminate\Contracts\View\View;
use Livewire\Component;
use {{namespace}}\{{moduleName}}\Services\Interfaces\{{className}}ServiceInterface;

class {{className}}Form extends Component
{
    public mixed ${{classNameLower}} = null;

    public mixed ${{classNameLower}}Id = null;

    public bool $isEditing = false;

    public string $name = '';

    /**
     * @var array<string, string>
     */
    protected $rules = [
        'name' => 'required|min:3',
    ];

    public function mount(mixed ${{classNameLower}}Id = null): void
    {
        if (${{classNameLower}}Id) {
            $this->{{classNameLower}}Id = ${{classNameLower}}Id;
            $this->isEditing = true;
            $this->loadModel();
        }
    }

    public function loadModel(): void
    {
        $this->{{classNameLower}} = app({{className}}ServiceInterface::class)->findById($this->{{classNameLower}}Id);
        $this->name = (string) $this->{{classNameLower}}->name;
    }

    public function save(): void
    {
        $this->validate();

        $service = app({{className}}ServiceInterface::class);
        $data = ['name' => $this->name];

        if ($this->isEditing) {
            $service->update($this->{{classNameLower}}Id, $data);
            $this->dispatch('{{classNameLower}}Updated');
            session()->flash('message', '{{className}} updated successfully');

            return;
        }

        $service->create($data);
        $this->dispatch('{{classNameLower}}Created');
        session()->flash('message', '{{className}} created successfully');
        $this->reset(['name']);
    }

    public function render()
    {
        return view('{{moduleNameLower}}::livewire.{{classNameLower}}-form');
    }
}
