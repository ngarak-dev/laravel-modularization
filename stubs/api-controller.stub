<?php

declare(strict_types=1);

namespace {{namespace}}\{{moduleName}}\Http\Controllers\API;

use App\Http\Controllers\Controller;
use Illuminate\Http\JsonResponse;
use {{namespace}}\{{moduleName}}\Http\Requests\{{className}}Request;
use {{namespace}}\{{moduleName}}\Services\Interfaces\{{className}}ServiceInterface;

class {{className}}Controller extends Controller
{
    public function __construct(
        protected {{className}}ServiceInterface $service,
    ) {
    }

    public function index(): JsonResponse
    {
        return response()->json(['data' => $this->service->getAll()]);
    }

    public function store({{className}}Request $request): JsonResponse
    {
        $data = $this->service->create($request->validated());

        return response()->json(['data' => $data, 'message' => '{{className}} created successfully'], 201);
    }

    public function show(string $id): JsonResponse
    {
        return response()->json(['data' => $this->service->findById($id)]);
    }

    public function update({{className}}Request $request, string $id): JsonResponse
    {
        $data = $this->service->update($id, $request->validated());

        return response()->json(['data' => $data, 'message' => '{{className}} updated successfully']);
    }

    public function destroy(string $id): JsonResponse
    {
        $this->service->delete($id);

        return response()->json(['message' => '{{className}} deleted successfully']);
    }
}
