{
    "name": "ngarak-dev/laravel-modularization",
    "description": "A Laravel package for module-based application architecture with Repository Pattern",
    "type": "library",
    "license": "MIT",
    "authors": [{
        "name": "Ngara K",
        "email": "ngarakiringo@gmail.com"
    }],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0",
        "livewire/livewire": "^3.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0",
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "NgarakDev\\Modularization\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "NgarakDev\\Modularization\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "NgarakDev\\Modularization\\Providers\\ModularizationServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}