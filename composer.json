{
    "name": "ngarak-dev/laravel-modularization",
    "description": "A Laravel package for business-domain modules with optional repository and service layers.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "modules",
        "modular",
        "repository",
        "service"
    ],
    "authors": [
        {
            "name": "Ngara K",
            "email": "ngarakiringo@gmail.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/console": "^10.0|^11.0|^12.0",
        "illuminate/filesystem": "^10.0|^11.0|^12.0",
        "illuminate/support": "^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0|^10.0",
        "phpunit/phpunit": "^10.5|^11.0",
        "laravel/pint": "^1.13",
        "phpstan/phpstan": "^1.11|^2.0",
        "livewire/livewire": "^3.0"
    },
    "suggest": {
        "livewire/livewire": "Required to auto-register Livewire components from modules (^3.0)."
    },
    "autoload": {
        "psr-4": {
            "NgarakDev\\Modularization\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "NgarakDev\\Modularization\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "NgarakDev\\Modularization\\Providers\\ModularizationServiceProvider"
            ],
            "aliases": {
                "Modularization": "NgarakDev\\Modularization\\Facades\\Modularization"
            }
        }
    },
    "scripts": {
        "test": "phpunit",
        "test-coverage": "phpunit --coverage-text",
        "pint": "pint",
        "format": "pint",
        "format-check": "pint --test",
        "analyse": "phpstan analyse --memory-limit=512M",
        "ci": [
            "@format-check",
            "@analyse",
            "@test"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        },
        "audit": {
            "block-insecure": false
        }
    }
}
