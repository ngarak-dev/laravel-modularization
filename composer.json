{
    "name": "ngarak-dev/laravel-modularization",
    "description": "A Laravel package for module-based application architecture with Repository + Service Pattern",
    "type": "library",
    "license": "MIT",
    "authors": [{
        "name": "Ngara K",
        "email": "ngarakiringo@gmail.com"
    }],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0",
        "phpunit/phpunit": "^10.0",
        "laravel/pint": "^1.18"
    },
    "suggest": {
        "livewire/livewire": "Required only when using module Livewire components (^3.0)"
    },
    "scripts": {
        "test": "phpunit",
        "test-coverage": "phpunit --coverage-text",
        "format": "vendor/bin/pint --test"
    },
    "autoload": {
        "psr-4": {
            "NgarakDev\\Modularization\\": "src/"
        },
        "files": [
            "src/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "NgarakDev\\Modularization\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "NgarakDev\\Modularization\\Providers\\ModularizationServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}